# Keep text files nomralized for Rasberry Pi / Linux use.
# This repo is edited on Windows but deploted/tested on Linux.

* text=auto eol=lf

#Source code / scripts
*.py text eol=lf
*.sh text eol=lf
*.bash text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.service text eol=lf

# Windows batch files can stay Windows-style if any exist.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary / generated files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
*.xlsx binary
*.docx binary
*.pptx binary

